{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "ConnectionStrings": {
    "DefaultConnection": "Host=postgres;Port=5432;Database=soundalone_db;Username=soundalone_user;Password=soundalone_secret_password;",
    "Kafka": "kafka:9092"
  },
  
  "Kafka": {
    "GroupId": "sender-service",
    "SubscribedTopics": [
      "email-send-commands"
    ]
  },

  "Minio": {
    "Endpoint": "minio:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin123",
    "BucketName": "soundalone-playlist-bucket",
    "UseSsl": false
  },

  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http1AndHttp2"
    }
  },

  "AllowedHosts": "*"
}