{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "ConnectionStrings": {
    "Postgres": "Host=postgres;Port=5432;Database=soundalone_db;Username=soundalone_user;Password=soundalone_secret_password;Search Path=auth_schema",
    "Redis": "redis:6379"
  },

  "Auth": {
    "JwtIssuer": "SoundAlone.AuthService",
    "JwtAudience": "SoundAlone.Services",
    "JwtSecret": "super-secret-key-change-in-production-soundalone-auth",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  
  "AllowedHosts": "*"
}
